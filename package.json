{
  "name": "vasta-orm",
  "version": "0.0.16",
  "description": "Active record ORM built on top of Kysely",
  "type": "module",
  "author": "David Nahodyl <david.nahodyl@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smef/vasta.git"
  },
  "bugs": {
    "url": "https://github.com/Smef/vasta/issues"
  },
  "homepage": "https://vastajs.com/",
  "keywords": [
    "orm",
    "kysely",
    "typescript",
    "active record"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "dev:docs": "cd docs && pnpm run dev",
    "test": "vitest run --typecheck",
    "test:reset": "pnpm run db:reset && vitest run",
    "test:watch": "vitest --typecheck",
    "clean": "rm -rf dist/*",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "generate:docs": "cd docs && pnpm run generate",
    "db:reset": "kysely migrate:rollback --all && kysely migrate:latest && kysely seed:run",
    "db:migrate": "kysely migrate:latest",
    "db:seed": "kysely seed:run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "format": "pnpm run fmt && pnpm run lint:fix",
    "publish": "pnpm run build && npm publish --access public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^9.1.2",
    "kysely": "^0.29.3",
    "kysely-ctl": "^0.21.0",
    "oxfmt": "^0.51.0",
    "pg": "^8.22.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "resolutions": {
    "unimport": "5.6.0",
    "citty": "0.1.6"
  },
  "packageManager": "pnpm@11.1.3"
}
