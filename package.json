{
  "name": "vasta-orm",
  "version": "0.0.14",
  "description": "Active record ORM built on top of Kysely",
  "type": "module",
  "author": "David Nahodyl <david.nahodyl@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smef/vasta.git"
  },
  "bugs": {
    "url": "https://github.com/Smef/vasta/issues"
  },
  "homepage": "https://vastajs.com/",
  "keywords": [
    "orm",
    "kysely",
    "typescript",
    "active record"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "dev:docs": "cd docs && pnpm run dev",
    "test": "vitest run --typecheck",
    "test:reset": "pnpm run db:reset && vitest run",
    "test:watch": "vitest --typecheck",
    "clean": "rm -rf dist/*",
    "build": "pnpm run clean && (npm run build:esm & npm run build:cjs)",
    "build:esm": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "generate:docs": "cd docs && pnpm run generate",
    "db:reset": "kysely migrate:rollback --all && kysely migrate:latest && kysely seed:run",
    "db:migrate": "kysely migrate:latest",
    "db:seed": "kysely seed:run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "format": "pnpm run fmt && pnpm run lint:fix",
    "publish": "pnpm run build && npm publish --access public"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "src/index.ts",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^9.1.2",
    "kysely": "^0.29.0",
    "kysely-ctl": "^0.21.0",
    "oxfmt": "^0.51.0",
    "pg": "^8.20.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "resolutions": {
    "unimport": "5.6.0",
    "citty": "0.1.6"
  },
  "packageManager": "pnpm@11.1.3"
}
